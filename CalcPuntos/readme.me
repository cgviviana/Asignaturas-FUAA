<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Calculadora de avance</title>
<style>
:root{
  --verde:#79c143;
  --verde-oscuro:#5aa92f;
  --negro:#1f2326;
  --gris-fondo:#f3f5f4;
  --borde:#dfe5e2;
  --texto-suave:#66706b;
  --rojo:#d94a4a;
  --amarillo:#c88700;
}
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial, Helvetica, sans-serif;
  background:var(--gris-fondo);
  color:var(--negro);
}
header{
  background:var(--negro);
  color:#fff;
  border-bottom:5px solid var(--verde);
  padding:16px;
}
.header-inner{
  max-width:920px;
  margin:auto;
}
header h1{
  margin:0;
  font-size:clamp(22px,4vw,30px);
}
header p{
  margin:5px 0 0;
  font-size:13px;
  color:#d1d7d4;
}
main{
  max-width:920px;
  margin:20px auto;
  padding:0 14px 24px;
}
.calculator{
  background:#fff;
  border-radius:18px;
  box-shadow:0 8px 24px rgba(0,0,0,.08);
  padding:18px;
}
.section-title{
  font-size:16px;
  font-weight:800;
  margin:0 0 10px;
}
.subnote{
  margin:10px 0 0;
  font-size:12px;
  color:var(--texto-suave);
  background:#fafbf9;
  border:1px dashed #cfd8d2;
  border-radius:10px;
  padding:10px 12px;
}
label{
  display:block;
  font-size:11px;
  font-weight:700;
  color:#56605b;
  margin-bottom:6px;
}
input{
  width:100%;
  padding:10px 9px;
  border:1.8px solid var(--borde);
  border-radius:10px;
  font-size:15px;
  outline:none;
  background:#fff;
}
input:focus{
  border-color:var(--verde);
  box-shadow:0 0 0 3px rgba(121,193,67,.12);
}
.converter-box{
  padding-bottom:16px;
  border-bottom:1px solid var(--borde);
}
.converter-grid{
  display:grid;
  grid-template-columns:1.5fr 220px;
  gap:10px;
  align-items:end;
}
.result-card{
  min-height:66px;
  border:1.8px solid #d7edc7;
  border-radius:12px;
  background:#eef8e8;
  padding:8px 10px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
}
.result-label{
  font-size:11px;
  font-weight:700;
  color:#56605b;
  margin-bottom:4px;
}
.result-value{
  font-size:22px;
  font-weight:800;
  color:var(--verde-oscuro);
}
.helper{
  margin-top:8px;
  font-size:12px;
  color:var(--texto-suave);
}
.ejes-wrap{
  margin-top:18px;
}
.ejes-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  border:1px solid var(--borde);
  border-radius:14px;
  overflow:hidden;
}
.eje-col{
  background:#fafbfb;
  padding:12px 10px;
  border-right:1px solid var(--borde);
}
.eje-col:last-child{
  border-right:none;
}
.eje-col h3{
  margin:0 0 10px;
  font-size:14px;
  font-weight:800;
}
.labels-row,.inputs-row{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}
.labels-row{
  margin-bottom:6px;
}
.cell-label{
  min-height:34px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
}
.cell-label .main{
  font-size:11px;
  font-weight:700;
  color:#56605b;
  line-height:1.1;
}
.cell-label .sub{
  font-size:10px;
  font-weight:700;
  color:#6e7773;
  line-height:1.1;
  margin-top:2px;
}
.inputs-row input{
  text-align:center;
}
.eje-total{
  margin-top:10px;
  text-align:center;
  font-size:12px;
  font-weight:700;
  color:#59645f;
}
.resumen{
  margin-top:18px;
}
.resumen-grid{
  display:grid;
  grid-template-columns:170px 1fr;
  gap:10px;
}
.total-box{
  background:var(--negro);
  color:#fff;
  border-radius:12px;
  padding:16px;
  text-align:center;
}
.total-box .numero{
  font-size:40px;
  font-weight:900;
  line-height:1;
}
.total-box small{
  color:#c7ceca;
}
.mensaje{
  border:1px solid var(--borde);
  border-radius:12px;
  background:#f8faf9;
  padding:14px;
  display:flex;
  align-items:center;
  min-height:78px;
}
.estado{
  font-size:18px;
  font-weight:800;
}
.estado.vacio{
  color:#8a9490;
  font-weight:600;
}
.good{color:var(--verde-oscuro)}
.warn{color:var(--amarillo)}
.bad{color:var(--rojo)}
footer{
  text-align:center;
  color:#7b8580;
  font-size:11px;
  padding:14px 0 4px;
}
@media(max-width:780px){
  .converter-grid{
    grid-template-columns:1fr;
  }
  .ejes-grid{
    grid-template-columns:repeat(2,1fr);
  }
  .eje-col:nth-child(2){
    border-right:none;
  }
  .eje-col:nth-child(1),
  .eje-col:nth-child(2){
    border-bottom:1px solid var(--borde);
  }
}
@media(max-width:520px){
  .ejes-grid{
    grid-template-columns:1fr;
  }
  .eje-col{
    border-right:none !important;
    border-bottom:1px solid var(--borde);
  }
  .eje-col:last-child{
    border-bottom:none;
  }
  .resumen-grid{
    grid-template-columns:1fr;
  }
}
</style>
</head>
<body>

<header>
  <div class="header-inner">
    <h1>Calculadora de avance</h1>
    <p>Herramienta de apoyo para convertir puntajes y revisar el acumulado por ejes</p>
  </div>
</header>

<main>
  <section class="calculator">

    <div class="converter-box">
      <div class="section-title">Conversor de puntos a nota</div>
      <div class="converter-grid">
        <div>
          <label for="puntos">Puntos obtenidos</label>
          <input id="puntos" type="number" min="0" max="100" step="0.1" placeholder="Ej. 45">
          <div class="helper">Se convierte automáticamente de 0–100 puntos a nota de 0–20.</div>
        </div>
        <div class="result-card">
          <div class="result-label">Nota equivalente</div>
          <div class="result-value" id="nota20">—</div>
        </div>
      </div>
    </div>

    <div class="ejes-wrap">
      <div class="section-title">Acumulado de avance por ejes</div>

      <div class="ejes-grid">
        <div class="eje-col">
          <h3>Eje 1</h3>
          <div class="labels-row">
            <div class="cell-label"><div class="main">Evaluativa</div><div class="sub">/20</div></div>
            <div class="cell-label"><div class="main">Complementaria</div><div class="sub">/5</div></div>
          </div>
          <div class="inputs-row">
            <input class="eval" data-eje="1" type="number" min="0" max="20" step="0.1" placeholder="0">
            <input class="comp" data-eje="1" type="number" min="0" max="5" step="0.1" placeholder="0">
          </div>
          <div class="eje-total"><span id="t1">0.0</span> / 25</div>
        </div>

        <div class="eje-col">
          <h3>Eje 2</h3>
          <div class="labels-row">
            <div class="cell-label"><div class="main">Evaluativa</div><div class="sub">/20</div></div>
            <div class="cell-label"><div class="main">Complementaria</div><div class="sub">/5</div></div>
          </div>
          <div class="inputs-row">
            <input class="eval" data-eje="2" type="number" min="0" max="20" step="0.1" placeholder="0">
            <input class="comp" data-eje="2" type="number" min="0" max="5" step="0.1" placeholder="0">
          </div>
          <div class="eje-total"><span id="t2">0.0</span> / 25</div>
        </div>

        <div class="eje-col">
          <h3>Eje 3</h3>
          <div class="labels-row">
            <div class="cell-label"><div class="main">Evaluativa</div><div class="sub">/20</div></div>
            <div class="cell-label"><div class="main">Complementaria</div><div class="sub">/5</div></div>
          </div>
          <div class="inputs-row">
            <input class="eval" data-eje="3" type="number" min="0" max="20" step="0.1" placeholder="0">
            <input class="comp" data-eje="3" type="number" min="0" max="5" step="0.1" placeholder="0">
          </div>
          <div class="eje-total"><span id="t3">0.0</span> / 25</div>
        </div>

        <div class="eje-col">
          <h3>Eje 4</h3>
          <div class="labels-row">
            <div class="cell-label"><div class="main">Evaluativa</div><div class="sub">/20</div></div>
            <div class="cell-label"><div class="main">Complementaria</div><div class="sub">/5</div></div>
          </div>
          <div class="inputs-row">
            <input class="eval" data-eje="4" type="number" min="0" max="20" step="0.1" placeholder="0">
            <input class="comp" data-eje="4" type="number" min="0" max="5" step="0.1" placeholder="0">
          </div>
          <div class="eje-total"><span id="t4">0.0</span> / 25</div>
        </div>
      </div>
    </div>

    <div class="resumen">
      <div class="resumen-grid">
        <div class="total-box">
          <div class="numero" id="total">0.0</div>
          <small>de 100 puntos</small>
        </div>
        <div class="mensaje">
          <div id="estado" class="estado vacio">Ingresa los puntajes para ver tu estado.</div>
        </div>
      </div>
      <div class="subnote">No es oficial. Solo es un apoyo para tus cálculos.</div>
    </div>

  </section>

  <footer>Aprendiendo con @LaProfeVivy</footer>
</main>

<script>
const puntos = document.getElementById('puntos');
const nota20 = document.getElementById('nota20');

function convertirPuntosANota(){
  if(puntos.value.trim() === ''){
    nota20.textContent = '—';
    return;
  }

  let p = parseFloat(puntos.value);
  if(isNaN(p)){
    nota20.textContent = '—';
    return;
  }

  if(p < 0){
    p = 0;
    puntos.value = 0;
  }
  if(p > 100){
    p = 100;
    puntos.value = 100;
  }

  const nota = (p / 100) * 20;
  nota20.textContent = nota.toFixed(1) + ' / 20';
}

function limitar(el){
  if(el.value.trim() === '') return 0;

  let v = parseFloat(el.value);
  if(isNaN(v)) return 0;

  const max = parseFloat(el.max);

  if(v < 0){
    v = 0;
    el.value = 0;
  }
  if(v > max){
    v = max;
    el.value = max;
  }
  return v;
}

function actualizarEjes(){
  let total = 0;
  let hayDatos = false;

  for(let i = 1; i <= 4; i++){
    const e = document.querySelector('.eval[data-eje="'+i+'"]');
    const c = document.querySelector('.comp[data-eje="'+i+'"]');

    if(e.value.trim() !== '' || c.value.trim() !== ''){
      hayDatos = true;
    }

    const t = limitar(e) + limitar(c);
    document.getElementById('t'+i).textContent = t.toFixed(1);
    total += t;
  }

  document.getElementById('total').textContent = total.toFixed(1);

  const estado = document.getElementById('estado');

  if(!hayDatos){
    estado.textContent = 'Ingresa los puntajes para ver tu estado.';
    estado.className = 'estado vacio';
    return;
  }

  if(total < 60){
    estado.textContent = 'Ánimo, te falta por llegar. Llevas ' + total.toFixed(1) + ' puntos.';
    estado.className = 'estado bad';
  } else if(total < 70){
    estado.textContent = 'Vas pasando raspando. Llevas ' + total.toFixed(1) + ' puntos.';
    estado.className = 'estado warn';
  } else {
    estado.textContent = 'Vas bien. Llevas ' + total.toFixed(1) + ' puntos.';
    estado.className = 'estado good';
  }
}

puntos.addEventListener('input', convertirPuntosANota);
document.querySelectorAll('.eval,.comp').forEach(el => el.addEventListener('input', actualizarEjes));

convertirPuntosANota();
actualizarEjes();
</script>

</body>
</html>
