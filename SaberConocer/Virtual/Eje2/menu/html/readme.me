    const title =
      document.getElementById("topicTitle");

    const intro =
      document.getElementById("topicIntro");

    const eyebrow =
      document.getElementById("eyebrow");

    const accordions =
      document.getElementById("accordions");

    const buttons =
      document.querySelectorAll(".topic-button");


    function renderTopic(key){

      const topic = topics[key];

      eyebrow.textContent =
        topic.eyebrow;

      title.textContent =
        topic.title;

      intro.textContent =
        topic.intro;


      accordions.innerHTML =
        topic.sections.map(section => `

          <article class="accordion">

            <button
              class="accordion-trigger"
              type="button"
            >

              <span>
                ${section.title}
              </span>

              <span class="accordion-icon"></span>

            </button>


            <div class="accordion-content">

              <div class="accordion-inner">

                <div class="accordion-body">
                  ${section.body}
                </div>

              </div>

            </div>

          </article>

        `).join("");


      document
        .querySelectorAll(".accordion-trigger")
        .forEach(trigger => {

          trigger.addEventListener("click", () => {

            const selected =
              trigger.parentElement;

            const wasOpen =
              selected.classList.contains("open");


            document
              .querySelectorAll(".accordion")
              .forEach(item => {

                item.classList.remove("open");

              });


            if(!wasOpen){

              selected.classList.add("open");

            }

          });

        });

    }


    buttons.forEach(button => {

      button.addEventListener("click", () => {

        buttons.forEach(item => {

          item.classList.remove("active");

        });

        button.classList.add("active");

        renderTopic(
          button.dataset.topic
        );

      });

    });


    renderTopic("encuentro1");

